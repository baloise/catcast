{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatCast",
  "version": "0.0.1",
  "identifier": "dev.baloise.catcast",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "stage",
        "title": "CatCast",
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
